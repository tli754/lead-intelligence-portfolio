# MongoDB connection used by backend/app/db.py
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=lead_intelligence

# Redis connection used by backend/app/queue.py (RQ queue/worker system)
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of origins allowed to call the API (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Base URL the frontend uses to reach the backend API
VITE_API_BASE_URL=http://localhost:8000
